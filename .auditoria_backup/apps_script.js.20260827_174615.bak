function normalizarIdComparacao(valor) {
  if (valor === null || valor === undefined) return null;
  var digitos = String(valor).replace(/\D/g, "");
  if (!digitos) return null;
  var semZeros = digitos.replace(/^0+/, "");
  return semZeros || "0";
}

function normalizarEnderecoParaBusca(texto) {
  return String(texto || "")
    .toLowerCase()
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .replace(/[^\w\s]/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function enderecoContemCidade(enderecoNorm) {
  for (var i = 0; i < GEO_CIDADES_PADRAO.length; i++) {
    if (enderecoNorm.indexOf(GEO_CIDADES_PADRAO[i]) !== -1) return true;
  }
  return false;
}

function limparSeparadoresEndereco(enderecoOriginal) {
  return String(enderecoOriginal || "")
    .replace(/\s+-\s+(?=[A-Za-zÀ-ú])/g, ", ")
    .replace(/,\s*,/g, ",")
    .trim();
}

function completarEnderecoComCidadePadrao(enderecoOriginal) {
  var limpo = limparSeparadoresEndereco(enderecoOriginal);
  var norm = normalizarEnderecoParaBusca(limpo);
  if (enderecoContemCidade(norm)) return limpo;
  return limpo + ", Belo Horizonte, MG";
}

function processarBuscarEnderecoGeo(sheet, data) {
  try {
    var enderecoOriginal = String(data.endereco_original || data.endereco || "").trim();
    if (!enderecoOriginal) return { status: "error", message: "endereco_original nao informado" };
    var enderecoNorm = normalizarEnderecoParaBusca(enderecoOriginal);
    var values = sheet.getDataRange().getValues();
    if (values.length <= 1) {
      return {
        status: "success",
        encontrado: false,
        endereco_normalizado: enderecoNorm,
        endereco_sugerido: completarEnderecoComCidadePadrao(enderecoOriginal)
      };
    }
    var headers = values[0].map(function (h) { return normalizarChave(h); });
    var idxNorm = headers.indexOf("endereco_normalizado");
    var idxLat = headers.indexOf("lat");
    var idxLng = headers.indexOf("lng");
    var idxQtd = headers.indexOf("qtd_usos");
    var idxOrigem = headers.indexOf("origem_resolucao");
    var idxCliente = headers.indexOf("cliente_solicitante");
    var idxId = headers.indexOf("id");
    if (idxNorm === -1) return { status: "error", message: "coluna endereco_normalizado nao encontrada" };
    for (var i = 1; i < values.length; i++) {
      var valNorm = String(values[i][idxNorm] || "").trim();
      if (valNorm === enderecoNorm) {
        var latAtual = idxLat !== -1 ? values[i][idxLat] : "";
        var lngAtual = idxLng !== -1 ? values[i][idxLng] : "";
        if (!latAtual || !lngAtual) {
          return {
            status: "success",
            encontrado: true,
            precisaGeocodificar: true,
            id: idxId !== -1 ? String(values[i][idxId]) : "",
            endereco_normalizado: enderecoNorm,
            endereco_sugerido: completarEnderecoComCidadePadrao(enderecoOriginal)
          };
        }
        if (idxQtd !== -1) {
          var qtdAtual = parseInt(values[i][idxQtd], 10);
          if (isNaN(qtdAtual)) qtdAtual = 0;
          sheet.getRange(i + 1, idxQtd + 1).setValue(qtdAtual + 1);
        }
        SpreadsheetApp.flush();
        invalidarCache("enderecos_geo");
        return {
          status: "success",
          encontrado: true,
          precisaGeocodificar: false,
          id: idxId !== -1 ? String(values[i][idxId]) : "",
          endereco_normalizado: enderecoNorm,
          endereco_original: enderecoOriginal,
          lat: latAtual,
          lng: lngAtual,
          cliente_solicitante: idxCliente !== -1 ? String(values[i][idxCliente]) : "",
          qtd_usos: idxQtd !== -1 ? String(values[i][idxQtd]) : "",
          origem_resolucao: idxOrigem !== -1 ? String(values[i][idxOrigem]) : ""
        };
      }
    }
    return {
      status: "success",
      encontrado: false,
      endereco_normalizado: enderecoNorm,
      endereco_original: enderecoOriginal,
      endereco_sugerido: completarEnderecoComCidadePadrao(enderecoOriginal)
    };
  } catch (err) {
    return { status: "error", message: "Erro em processarBuscarEnderecoGeo: " + err.toString() };
  }
}

function processarSalvarEnderecoGeo(sheet, data) {
  try {
    var enderecoOriginal = String(data.endereco_original || data.endereco || "").trim();
    if (!enderecoOriginal) return { status: "error", message: "endereco_original nao informado" };
    var enderecoNorm = normalizarEnderecoParaBusca(enderecoOriginal);

    var lat = _normalizarCoordenadaParaSalvar(data.lat);
    var lng = _normalizarCoordenadaParaSalvar(data.lng);

    var clienteSolicitante = String(data.cliente_solicitante || data.cliente || "").trim();
    var origemResolucao = String(data.origem_resolucao || "geocodificado").trim();
    var values = sheet.getDataRange().getValues();
    var headers = values.length > 0
      ? values[0].map(function (h) { return normalizarChave(h); })
      : ["id", "endereco_normalizado", "endereco_original", "lat", "lng", "cliente_solicitante", "qtd_usos", "origem_resolucao"];
    var idxNorm = headers.indexOf("endereco_normalizado");
    var idxLat = headers.indexOf("lat");
    var idxLng = headers.indexOf("lng");
    var idxQtd = headers.indexOf("qtd_usos");
    var idxOrigem = headers.indexOf("origem_resolucao");
    var idxCliente = headers.indexOf("cliente_solicitante");
    var idxId = headers.indexOf("id");

    if (idxNorm !== -1) {
      for (var i = 1; i < values.length; i++) {
        var valNorm = String(values[i][idxNorm] || "").trim();
        if (valNorm === enderecoNorm) {
          if (idxLat !== -1 && lat) escreverComoTexto(sheet, i + 1, idxLat + 1, lat);
          if (idxLng !== -1 && lng) escreverComoTexto(sheet, i + 1, idxLng + 1, lng);
          if (idxOrigem !== -1) sheet.getRange(i + 1, idxOrigem + 1).setValue(origemResolucao);
          if (idxQtd !== -1) {
            var qtdAtual = parseInt(values[i][idxQtd], 10);
            if (isNaN(qtdAtual)) qtdAtual = 0;
            sheet.getRange(i + 1, idxQtd + 1).setValue(qtdAtual + 1);
          }
          SpreadsheetApp.flush();
          invalidarCache("enderecos_geo");
          return {
            status: "success",
            message: "Endereco atualizado com coordenadas!",
            id: idxId !== -1 ? String(values[i][idxId]) : "",
            atualizado: true
          };
        }
      }
    }

    var id = gerarId(sheet, "enderecos_geo");
    var rowData = {
      id: id,
      endereco_normalizado: enderecoNorm,
      endereco_original: enderecoOriginal,
      lat: lat,
      lng: lng,
      cliente_solicitante: clienteSolicitante,
      qtd_usos: "1",
      origem_resolucao: origemResolucao
    };
    var row = [];
    for (var h = 0; h < headers.length; h++) {
      var campo = headers[h];
      row.push(rowData[campo] !== undefined ? rowData[campo] : "");
    }
    sheet.appendRow(row);
    SpreadsheetApp.flush();

    var novaLinha = sheet.getLastRow();
    if (idxLat !== -1 && lat) escreverComoTexto(sheet, novaLinha, idxLat + 1, lat);
    if (idxLng !== -1 && lng) escreverComoTexto(sheet, novaLinha, idxLng + 1, lng);
    SpreadsheetApp.flush();

    invalidarCache("enderecos_geo");
    return { status: "success", message: "Endereco criado com sucesso!", id: id, atualizado: false };
  } catch (err) {
    return { status: "error", message: "Erro em processarSalvarEnderecoGeo: " + err.toString() };
  }
}

function corrigirCoordenadasCorrompidas() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = buscarAba(ss, "enderecos_geo");
  if (!sheet) { Logger.log("Aba nao encontrada"); return; }

  var values = sheet.getDataRange().getValues();
  var headers = values[0].map(function (h) { return normalizarChave(h); });
  var idxLat = headers.indexOf("lat");
  var idxLng = headers.indexOf("lng");
  if (idxLat === -1 || idxLng === -1) { Logger.log("Colunas lat/lng nao encontradas"); return; }

  var corrigidos = 0;

  function _corrigirValor(valor) {
    if (valor === "" || valor === null || valor === undefined) return null;
    var num = parseFloat(String(valor).toString().replace(",", "."));
    if (isNaN(num)) return null;
    if (Math.abs(num) > 180) {
      var str = String(Math.trunc(num));
      var negativo = str.indexOf("-") === 0;
      var digitos = negativo ? str.slice(1) : str;
      var parteInteira = digitos.slice(0, 2);
      var parteDecimal = digitos.slice(2);
      num = parseFloat((negativo ? "-" : "") + parteInteira + "." + parteDecimal);
    }
    return isNaN(num) ? null : num;
  }

  for (var i = 1; i < values.length; i++) {
    var latBruto = values[i][idxLat];
    var lngBruto = values[i][idxLng];
    var latCorrigido = _corrigirValor(latBruto);
    var lngCorrigido = _corrigirValor(lngBruto);

    if (latCorrigido !== null) {
      escreverComoTexto(sheet, i + 1, idxLat + 1, latCorrigido.toString());
    }
    if (lngCorrigido !== null) {
      escreverComoTexto(sheet, i + 1, idxLng + 1, lngCorrigido.toString());
    }
    if (latCorrigido !== null || lngCorrigido !== null) corrigidos++;
  }

  SpreadsheetApp.flush();
  invalidarCache("enderecos_geo");
  Logger.log("Linhas corrigidas: " + corrigidos);
}

function _normalizarCoordenadaParaSalvar(valorBruto) {
  if (valorBruto === undefined || valorBruto === null || valorBruto === "") return "";
  var num = parseFloat(String(valorBruto).replace(",", "."));
  if (isNaN(num)) return "";
  return num.toString();
}

function _chaveCache(nomeAba) {
  return "CACHE_ABA_" + String(nomeAba).toLowerCase().trim();
}

function invalidarCache(nomeAba) {
  try {
    CacheService.getScriptCache().remove(_chaveCache(nomeAba));
  } catch (err) {
    console.error("Erro ao invalidar cache de '" + nomeAba + "': " + err.toString());
  }
}

function obterUltimaAtualizacaoAba(sheet) {
  try {
    var lastRow = sheet.getLastRow();
    var lastCol = sheet.getLastColumn();
    if (lastRow <= 1) return "";
    var headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0].map(function (h) {
      return normalizarChave(h);
    });
    var colUpdated = headers.indexOf("updated_at");
    if (colUpdated === -1) return String(lastRow);
    var valores = sheet.getRange(2, colUpdated + 1, lastRow - 1, 1).getValues();
    var maior = "";
    for (var i = 0; i < valores.length; i++) {
      var v = String(valores[i][0] || "");
      if (v > maior) maior = v;
    }
    return maior + "_" + lastRow;
  } catch (err) {
    return "";
  }
}

function processarGetComCache(sheet, nomeAba) {
  try {
    var cache = CacheService.getScriptCache();
    var chave = _chaveCache(nomeAba);
    var forcarBypass = nomeAba === "usuarios";
    if (!forcarBypass) {
      var ultimoUpdate = obterUltimaAtualizacaoAba(sheet);
      var cacheado = cache.get(chave);
      if (cacheado) {
        var envelope = JSON.parse(cacheado);
        if (envelope.ultimo_update === ultimoUpdate) {
          return { status: "success", data: envelope.data, cache: true };
        }
      }
    }
    var dados = processarGet(sheet);
    if (!forcarBypass) {
      try {
        cache.put(chave, JSON.stringify({ ultimo_update: ultimoUpdate, data: dados }), CACHE_TTL_SEGUNDOS);
      } catch (errPut) {
        console.error("Falha ao gravar cache de '" + nomeAba + "': " + errPut.toString());
      }
    }
    return { status: "success", data: dados, cache: false };
  } catch (err) {
    return { status: "error", message: "Erro em processarGetComCache: " + err.toString() };
  }
}

function normalizarChave(str) {
  return String(str || "")
    .replace(/([a-z0-9])([A-Z])/g, '$1_$2')
    .toLowerCase()
    .trim()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/[\s\/]+/g, '_');
}

function ehCampoMonetario(chave) {
  return CAMPOS_MONETARIOS.indexOf(chave) !== -1;
}

function timestampAtual() {
  return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd/MM/yyyy HH:mm:ss");
}

function formatarMoeda(valor) {
  if (valor === null || valor === undefined || valor === "") return "";
  var texto = String(valor).trim();
  if (texto === "") return "";
  if (/^R\$\s*-?\d/.test(texto)) return texto;
  var limpo = texto.replace(/[^\d,.\-]/g, "");
  if (limpo === "") return "";
  var negativo = limpo.indexOf("-") === 0;
  limpo = limpo.replace("-", "");
  var numero;
  if (limpo.indexOf(",") !== -1) {
    limpo = limpo.replace(/\./g, "").replace(",", ".");
    numero = parseFloat(limpo);
  } else {
    numero = parseFloat(limpo);
  }
  if (isNaN(numero)) return texto;
  var formatado = numero.toFixed(2).replace(".", ",");
  var partes = formatado.split(",");
  var inteiro = partes[0];
  var decimal = partes[1];
  var comMilhares = "";
  var contador = 0;
  for (var i = inteiro.length - 1; i >= 0; i--) {
    comMilhares = inteiro.charAt(i) + comMilhares;
    contador++;
    if (contador % 3 === 0 && i !== 0) {
      comMilhares = "." + comMilhares;
    }
  }
  return (negativo ? "-" : "") + "R$ " + comMilhares + "," + decimal;
}

